# Secrets — never commit real env files; keep a committed .env.example instead
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-machine settings (shared config lives in .claude/settings.json)
.claude/settings.local.json

# Dependencies & build output
node_modules/
dist/
build/
.next/
.vercel/
__pycache__/
.venv/
*.log

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
web/node_modules/

# Agent worktrees (created by the subagent-driven build, never committed)
.claude/worktrees/

# Source artifacts kept locally (unpacked into .claude/skills/ when adopted)
external_assets/
