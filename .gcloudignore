# What `gcloud run deploy --source .` must NOT upload to Cloud Build.
# Explicit, so gcloud does not derive one from .gitignore behind our backs.

.git/
.gitignore
.github/
.claude/
.scratch/
.superpowers/
docs/
scripts/
# The Triage Agent is a second deployable (`make deploy-functions`), not part of the image —
# and after a deploy it holds a copy of core/ and knowledge/ that would otherwise ship twice.
functions/
external_assets/

node_modules/
dist/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Configuration and secrets never leave the laptop; Cloud Run gets environment variables.
.env
.env.*

*.md
# ...except the Knowledge Base, which *is* markdown and ships in the image (ADR-0001).
!knowledge/*.md
knowledge/README.md
