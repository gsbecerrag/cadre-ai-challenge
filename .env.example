# Cadre AI Support Agent — environment configuration
# Copy to .env (gitignored) and fill the secrets. One file at the repo root serves the
# FastAPI app, the triage Cloud Function (copied at deploy), the eval suite, and Vite
# (web/vite.config.ts sets envDir to the repo root; only VITE_* vars reach the browser).
# In Cloud Run, secrets come from Secret Manager, not from this file.

# ---------------------------------------------------------------- LLM (OpenRouter)
OPENROUTER_API_KEY=                                  # secret — the key Cadre issued (your own key is the spare); `make rotate-openrouter-key` swaps the deployed one
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER=stub                                  # openrouter | stub (stub = no API spend; used by CI, the load smoke test and the local demo)
CONVERSATION_STORE=memory                            # firestore | memory (memory is process-local: one instance only, and gone on restart)
CHAT_MODEL=anthropic/claude-sonnet-5                 # conversation model (benchmark may change this)
JUDGE_MODEL=anthropic/claude-haiku-4.5               # eval judge
TRIAGE_MODEL=anthropic/claude-sonnet-5               # thumbs-down triage agent
PROMPT_CACHE_TTL=1h                                  # 5m | 1h — Anthropic cache TTL for the system prompt
BENCHMARK_MODELS=anthropic/claude-sonnet-5,anthropic/claude-haiku-4.5,openai/gpt-5.6-sol,google/gemini-3.7-flash
OPENROUTER_APP_URL=                                  # HTTP-Referer for OpenRouter attribution (the deployed URL)
OPENROUTER_APP_NAME="Cadre AI Support Agent"           # X-OpenRouter-Title

# ---------------------------------------------------------------- GCP / Firebase
GOOGLE_CLOUD_PROJECT=cadre-ai-challenge
GCP_REGION=us-central1
# Local auth uses Application Default Credentials: `gcloud auth application-default login`.
# Set GOOGLE_APPLICATION_CREDENTIALS only if you deliberately use a service-account key file.
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_ALLOWED_EMAILS=galo.s.becerra@gmail.com        # comma-separated; console (Firebase Auth, Google or email/password sign-in) allowlist. Blank admits nobody. `make rules` renders it into firestore.rules too. The Makefile's deploy default also lists the demo account (strategist@cadre-demo.example, ticket 20) so a reviewer without a Google account can sign in; add it here too if you want it locally
CONSOLE_AUTH=firebase                                # firebase | fake — `fake` accepts fake:<email> credentials with no Google sign-in and is refused unless ENV=development (demo/screenshots only)
FIREBASE_PROJECT_ID=                                 # audience for console ID-token verification; blank falls back to GOOGLE_CLOUD_PROJECT

# Firebase web app config — public by design, shipped to the browser (from `firebase apps:sdkconfig WEB`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cadre-ai-challenge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cadre-ai-challenge
VITE_FIREBASE_APP_ID=
# The committed defaults in web/src/console/firebase.ts are used when these are unset; set them only to point the console at another Firebase project.
VITE_CONSOLE_AUTH=                                   # `fake` makes the console sign-in page offer a demo Strategist (pairs with CONSOLE_AUTH=fake); leave blank for Google sign-in
VITE_CONSOLE_FAKE_EMAIL=                             # the demo Strategist's email when VITE_CONSOLE_AUTH=fake; must be on ADMIN_ALLOWED_EMAILS

# ---------------------------------------------------------------- Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=                                 # pk-lf-... — both keys set turns tracing on
LANGFUSE_SECRET_KEY=                                 # secret — sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com          # the project's region: us. or cloud. (EU)
LOGLEVEL=INFO                                        # DEBUG (prompt/response bodies, PII-redacted) | INFO | WARNING | ERROR

# ---------------------------------------------------------------- Live hand-over (Daily.co)
DAILY_API_KEY=                                       # secret
DAILY_DOMAIN=                                        # e.g. cadre-demo.daily.co
LIVE_HANDOVER_ENABLED=false                          # feature flag: false → the bot offers a callback instead of a video call. On with no DAILY_API_KEY is the same thing: every acceptance is a Callback
HANDOVER_JOIN_TIMEOUT_SECONDS=120                    # how long the visitor watches the connecting spinner before the hand-over degrades to a callback

# ---------------------------------------------------------------- App
ENV=development                                      # development | production
PORT=8080
APP_VERSION=0.1.0                                    # reported by /healthz; `make deploy` sets the git short sha
APP_BASE_URL=http://localhost:8080                   # used in walkthrough deep links and console links
CHAT_ACCESS_CODE=                                    # blank = no gate; set, a browser must give it once before a Turn (deployed: `make set-chat-access-code`, Secret Manager chat-access-code)
SESSION_COOKIE_SECRET=                               # secret — `openssl rand -hex 32`; signs the session cookie, required when ENV=production (`make deploy` binds it from Secret Manager)
MAX_TURNS_PER_SESSION=40                             # burst guard; conversation ends politely past this
QUALIFICATION_THRESHOLD=3                            # BANT-lite score (0–5) that unlocks the live-call offer
