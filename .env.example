# Cadre AI Support Agent — environment configuration
# Copy to .env (gitignored) and fill the secrets. One file at the repo root serves the
# FastAPI app, the triage Cloud Function (copied at deploy), the eval suite, and Vite
# (web/vite.config.ts sets envDir to the repo root; only VITE_* vars reach the browser).
# In Cloud Run, secrets come from Secret Manager, not from this file.

# ---------------------------------------------------------------- LLM (OpenRouter)
OPENROUTER_API_KEY=                                  # secret — provided by Cadre
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER=stub                                  # openrouter | stub (stub = no API spend; used by CI, the load smoke test and the local demo; openrouter arrives with ticket 03)
CHAT_MODEL=anthropic/claude-sonnet-5                 # conversation model (benchmark may change this)
JUDGE_MODEL=anthropic/claude-haiku-4.5               # eval judge
TRIAGE_MODEL=anthropic/claude-sonnet-5               # thumbs-down triage agent
PROMPT_CACHE_TTL=1h                                  # 5m | 1h — Anthropic cache TTL for the system prompt
BENCHMARK_MODELS=anthropic/claude-sonnet-5,anthropic/claude-haiku-4.5,openai/gpt-5.6-sol,google/gemini-3.7-flash
OPENROUTER_APP_URL=                                  # HTTP-Referer for OpenRouter attribution (the deployed URL)
OPENROUTER_APP_NAME="Cadre AI Support Agent"           # X-OpenRouter-Title

# ---------------------------------------------------------------- GCP / Firebase
GOOGLE_CLOUD_PROJECT=cadre-ai-challenge
GCP_REGION=us-central1
# Local auth uses Application Default Credentials: `gcloud auth application-default login`.
# Set GOOGLE_APPLICATION_CREDENTIALS only if you deliberately use a service-account key file.
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_ALLOWED_EMAILS=galo.s.becerra@gmail.com        # comma-separated; console (Firebase Auth, Google sign-in) allowlist

# Firebase web app config — public by design, shipped to the browser (from `firebase apps:sdkconfig WEB`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cadre-ai-challenge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cadre-ai-challenge
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------- Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=                                 # pk-lf-...
LANGFUSE_SECRET_KEY=                                 # secret — sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com             # or https://us.cloud.langfuse.com
LOGLEVEL=INFO                                        # DEBUG (prompt/response bodies, PII-redacted) | INFO | WARNING | ERROR

# ---------------------------------------------------------------- Live hand-over (Daily.co)
DAILY_API_KEY=                                       # secret
DAILY_DOMAIN=                                        # e.g. cadre-demo.daily.co
LIVE_HANDOVER_ENABLED=true                           # feature flag: false → bot offers a callback instead of a video call

# ---------------------------------------------------------------- App
ENV=development                                      # development | production
PORT=8080
APP_VERSION=0.1.0                                    # reported by /healthz; `make deploy` sets the git short sha
APP_BASE_URL=http://localhost:8080                   # used in walkthrough deep links and console links
SESSION_COOKIE_SECRET=                               # secret — `openssl rand -hex 32`
MAX_TURNS_PER_SESSION=40                             # burst guard; conversation ends politely past this
QUALIFICATION_THRESHOLD=3                            # BANT-lite score (0–5) that unlocks the live-call offer
